{
  "name": "portfolio-rafael-dias",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "preview": "vite preview",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "prepare": "husky",
    "test:hooks": "node --test .claude/hooks/guard-bash.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
